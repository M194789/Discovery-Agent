# OpenAI API Configuration (required for DeepSeek backend)
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Model Configuration
AGENT_MODEL_NAME=deepseek-v4-pro

# Require API Key (set to false for local models or testing)
REQUIRE_OPENAI_API_KEY=true

# Tavily Search API Key (required for literature mining)
TAVILY_API_KEY=tvly-your-tavily-api-key-here
